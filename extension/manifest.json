{
  "manifest_version": 3,
  "name": "YTM → Discord bridge",
  "version": "0.4.0",
  "description": "Shows the track playing in YouTube Music as your Discord status.",
  "permissions": ["storage"],
  "host_permissions": ["https://music.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YTM → Discord",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["relay.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
